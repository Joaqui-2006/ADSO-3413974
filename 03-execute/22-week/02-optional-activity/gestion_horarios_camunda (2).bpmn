<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GestionHorarios" targetNamespace="http://sena.local/gestion-horarios" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_GestionHorarios">
    <bpmn:participant id="Participant_Coordinador" name="Coordinador académico" processRef="Process_Coordinador" />
    <bpmn:participant id="Participant_Instructor" name="Instructor" processRef="Process_Instructor" />
    <bpmn:messageFlow id="Message_HorarioPublicado" name="Horario publicado" sourceRef="Task_PublicarHorario" targetRef="Start_HorarioPublicado" />
    <bpmn:messageFlow id="Message_SolicitudSeguimiento" name="Solicitud de seguimiento" sourceRef="Task_SolicitarSeguimiento" targetRef="Catch_SolicitudSeguimiento" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Coordinador" name="Gestión del horario" isExecutable="false">
    <bpmn:startEvent id="Start_Gestion" name="Iniciar gestión">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CrearEditar" name="Crear o editar horario">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RevisarConflictos" name="Revisar conflictos">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F4_LOOP</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Conflictos" name="¿Existen conflictos?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4_SI</bpmn:outgoing>
      <bpmn:outgoing>F4_NO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorregirConflictos" name="Corregir conflictos">
      <bpmn:incoming>F4_SI</bpmn:incoming>
      <bpmn:outgoing>F4_LOOP</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AgregarSesion" name="Agregar sesión">
      <bpmn:incoming>F4_NO</bpmn:incoming>
      <bpmn:incoming>F6_SI</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OtraSesion" name="¿Hay otra sesión?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6_SI</bpmn:outgoing>
      <bpmn:outgoing>F6_NO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ValidarHorario" name="Validar horario">
      <bpmn:incoming>F6_NO</bpmn:incoming>
      <bpmn:incoming>F8_LOOP</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HorarioValido" name="¿Horario válido?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8_SI</bpmn:outgoing>
      <bpmn:outgoing>F8_NO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorregirDatos" name="Corregir datos del horario">
      <bpmn:incoming>F8_NO</bpmn:incoming>
      <bpmn:outgoing>F8_LOOP</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PublicarHorario" name="Publicar horario">
      <bpmn:incoming>F8_SI</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_SolicitudSeguimiento" name="Esperar solicitud de seguimiento">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Seguimiento" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_RegistrarSeguimiento" name="Registrar seguimiento">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F13_LOOP</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DatosValidos" name="¿Datos válidos?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12_SI</bpmn:outgoing>
      <bpmn:outgoing>F12_NO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CorregirSeguimiento" name="Corregir seguimiento">
      <bpmn:incoming>F12_NO</bpmn:incoming>
      <bpmn:outgoing>F13_LOOP</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Seguimiento" name="Seguimiento registrado">
      <bpmn:incoming>F12_SI</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Gestion" targetRef="Task_CrearEditar" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CrearEditar" targetRef="Task_RevisarConflictos" />
    <bpmn:sequenceFlow id="F4_LOOP" sourceRef="Task_CorregirConflictos" targetRef="Task_RevisarConflictos" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_RevisarConflictos" targetRef="Gateway_Conflictos" />
    <bpmn:sequenceFlow id="F4_SI" name="Sí" sourceRef="Gateway_Conflictos" targetRef="Task_CorregirConflictos" />
    <bpmn:sequenceFlow id="F4_NO" name="No" sourceRef="Gateway_Conflictos" targetRef="Task_AgregarSesion" />
    <bpmn:sequenceFlow id="F6_SI" name="Sí" sourceRef="Gateway_OtraSesion" targetRef="Task_AgregarSesion" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_AgregarSesion" targetRef="Gateway_OtraSesion" />
    <bpmn:sequenceFlow id="F6_NO" name="No" sourceRef="Gateway_OtraSesion" targetRef="Task_ValidarHorario" />
    <bpmn:sequenceFlow id="F8_LOOP" sourceRef="Task_CorregirDatos" targetRef="Task_ValidarHorario" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_ValidarHorario" targetRef="Gateway_HorarioValido" />
    <bpmn:sequenceFlow id="F8_NO" name="No" sourceRef="Gateway_HorarioValido" targetRef="Task_CorregirDatos" />
    <bpmn:sequenceFlow id="F8_SI" name="Sí" sourceRef="Gateway_HorarioValido" targetRef="Task_PublicarHorario" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_PublicarHorario" targetRef="Catch_SolicitudSeguimiento" />
    <bpmn:sequenceFlow id="F10" sourceRef="Catch_SolicitudSeguimiento" targetRef="Task_RegistrarSeguimiento" />
    <bpmn:sequenceFlow id="F13_LOOP" sourceRef="Task_CorregirSeguimiento" targetRef="Task_RegistrarSeguimiento" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_RegistrarSeguimiento" targetRef="Gateway_DatosValidos" />
    <bpmn:sequenceFlow id="F12_NO" name="No" sourceRef="Gateway_DatosValidos" targetRef="Task_CorregirSeguimiento" />
    <bpmn:sequenceFlow id="F12_SI" name="Sí" sourceRef="Gateway_DatosValidos" targetRef="End_Seguimiento" />
  </bpmn:process>
  <bpmn:process id="Process_Instructor" name="Consulta y seguimiento del instructor" isExecutable="false">
    <bpmn:startEvent id="Start_HorarioPublicado" name="Horario publicado">
      <bpmn:outgoing>I1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Horario" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ConsultarHorario" name="Consultar horario">
      <bpmn:incoming>I1</bpmn:incoming>
      <bpmn:outgoing>I2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RegistrarAsistencia" name="Registrar asistencia y avance">
      <bpmn:incoming>I2</bpmn:incoming>
      <bpmn:outgoing>I3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RequiereSeguimiento" name="¿Requiere seguimiento?">
      <bpmn:incoming>I3</bpmn:incoming>
      <bpmn:outgoing>I4_SI</bpmn:outgoing>
      <bpmn:outgoing>I4_NO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SolicitarSeguimiento" name="Solicitar seguimiento">
      <bpmn:incoming>I4_SI</bpmn:incoming>
      <bpmn:outgoing>I5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Solicitud" name="Solicitud enviada">
      <bpmn:incoming>I5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Registro" name="Registro completo">
      <bpmn:incoming>I4_NO</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="I1" sourceRef="Start_HorarioPublicado" targetRef="Task_ConsultarHorario" />
    <bpmn:sequenceFlow id="I2" sourceRef="Task_ConsultarHorario" targetRef="Task_RegistrarAsistencia" />
    <bpmn:sequenceFlow id="I3" sourceRef="Task_RegistrarAsistencia" targetRef="Gateway_RequiereSeguimiento" />
    <bpmn:sequenceFlow id="I4_SI" name="Sí" sourceRef="Gateway_RequiereSeguimiento" targetRef="Task_SolicitarSeguimiento" />
    <bpmn:sequenceFlow id="I4_NO" name="No" sourceRef="Gateway_RequiereSeguimiento" targetRef="End_Registro" />
    <bpmn:sequenceFlow id="I5" sourceRef="Task_SolicitarSeguimiento" targetRef="End_Solicitud" />
  </bpmn:process>
  <bpmn:message id="Message_Horario" name="Horario publicado" />
  <bpmn:message id="Message_Seguimiento" name="Solicitud de seguimiento" />
